@startuml
start
partition 信息展示 {
  :调用后台接口获取用户数据;
  if (获取成功?) then (是)
    :展示头像/姓名/地址/电话;
  else (否)
    :显示"数据加载失败"提示;
  endif
}

partition 编辑操作 {
  :点击编辑按钮;
  fork
    group 头像修改
    :选择相册或拍照;
    :上传图片至服务器;
    if (上传成功?) then (是)
      :更新本地头像预览;
    else (否)
      :保留原头像;
    endif
    end group
  fork again
    group 文本字段修改 
    :点击姓名/地址/电话字段;
    :弹出输入对话框;
    :输入新内容;
    if (格式验证通过?) then (是)
      :临时保存修改内容;
    else (否)
      :提示"格式错误"并清空输入;
    endif
    end group
  end fork

  :点击保存按钮;
  :组装修改数据包;
  :调用后台更新接口;
  if (更新成功?) then (是)
    :刷新本地缓存数据;
    :显示"保存成功"提示;
  else (否)
    :显示"保存失败"错误码;
    :回滚未保存的修改;
  endif
}
stop
@enduml