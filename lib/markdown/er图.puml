@startuml
hide empty members
left to right direction
entity 用户 {
  *用户ID
  --
  昵称
  姓
  名
  头像URL
  手机号 <<UQ>>
  邮箱 <<UQ>>
  加密密码
  地址
  登录类型 <<枚举：Facebook/Apple/邮箱>>
  访问令牌
  创建时间
  最后登录时间
  过期时间
}

entity 实名认证 {
  *认证ID
  --
  #用户ID
  实名
  实姓
  认证状态 <<枚举：待审核/通过/拒绝>>
  提交时间
  证件正面照片
  证件背面照片
}

entity 车辆 {
  *车辆ID
  --
  #用户ID
  车架号
  当前电量
  续航里程
  手机钥匙开关<<bool>>
  速度限制开关<<bool>>
  驾驶模式 <<枚举：经济/运动/狂暴>>
  动能回收强度<<枚举：无/中/强>>
  最高限速
  当前速度
  遥控距离
  激活时间
  绑定状态 <<枚举：已绑定/未绑定>>
}

entity 车钥匙 {
  *钥匙ID
  --
  #车辆ID
  #接收用户ID
  创建时间
  过期时间
  是否有效 <<bool>>
  使用次数
}

entity 行程记录 {
  *行程ID
  --
  #用户ID
  #车辆ID
  行程开始时间
  行程结束时间
  起点坐标 <<GIS>>
  终点坐标 <<GIS>>
  平均速度
}

entity 遥控记录 {
  *指令ID
  --
  #用户ID
  #车辆ID
  操作类型 <<枚举：启动/车灯/喇叭/车锁/前进/后退>>
  操作时间
  操作状态 <<枚举：成功/失败>>
  坐标位置 <<GIS>>
}

entity OTA升级 {
  *升级ID
  --
  #车辆ID
  目标版本
  文件校验值
  升级状态 <<枚举：待升级/升级中/成功/失败>>
  开始时间
  结束时间
}

entity APP升级 {
  *升级ID
  --
  #用户ID
  平台类型 <<枚举：Android/iOS>>
  当前版本
  最新版本
  最后检查时间
}

' 关系定义
用户 ||--o{ 车辆 : "拥有1:N"
用户 ||--|| 实名认证 : "需要认证1:1"
用户 ||--o{ 行程记录 : "产生轨迹1:N"
用户 ||--o{ 遥控记录 : "发送指令1:N"
用户 ||--o{ APP升级 : "触发检查1:N"

车辆 ||--o{ 车钥匙 : "分享控制1:N"
用户 ||--o{ 遥控记录 : "执行指令1:N"
车辆 ||--o{ OTA升级 : "固件升级1:N"
车辆 ||--o{ 行程记录 : "行驶记录1:N"

车钥匙 ||--|| 用户 : "授权给"

' note right of 车辆::绑定状态
'   绑定解绑通过修改状态实现
'   解绑后保留历史数据
' end note

' note bottom of 车钥匙::是否有效
'   通过触发器限制：
'   1. 同车辆有效钥匙≤3
'   2. 接收用户≠车主
' end note

' note left of 行程记录::轨迹数据
'   存储规范：
'   1. WGS84坐标系
'   2. 每10秒记录一个轨迹点
'   3. 使用PostGIS扩展
' end note
@enduml