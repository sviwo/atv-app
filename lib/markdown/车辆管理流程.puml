@startuml
start
:用户点击车辆管理选项卡;
partition 初始化流程 {
  :调用后台接口获取已绑定车辆列表;
  if (获取成功?) then (是)
    :展示车辆卡片列表;
  else (否)
    :展示空列表;
  endif
}

partition 车辆操作 {
  if (用户选择操作类型) then (绑定新车)
    :点击首页扫一扫;
    :输入车辆ID/扫描二维码;
    :调用后台接口验证车辆车架号;
    if (验证通过?) then (是)
      :蓝牙配对验证车辆;
      :添加车辆到本地列表;
      :展示新的车辆列表;
    else (否)
      :提示"车辆绑定失败,给出原因";
    endif
  elseif (解绑车辆)
    :点击车辆删除按钮;
    :弹出解绑确认对话框;
    if (用户确认解绑) then (是)
      :调用后台接口删除车辆绑定;
      :从本地列表移除车辆;
      :展示删除此车辆后的车辆列表;
    endif
  elseif (钥匙操作)
    :点击指定车辆钥匙管理;
    if (操作类型) then (分享钥匙)
      :调用后台生成密钥字符串;
      :复制密钥到剪贴板;
      :提示"车钥匙已复制到粘贴板";
    elseif (删除钥匙)
      :点击车钥匙的删除按钮;
      :调用后台接口删除钥匙;
      :刷新本地钥匙列表;
    endif
  endif
}

:返回主界面;
stop
@enduml