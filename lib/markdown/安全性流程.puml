@startuml
' start
:用户点击安全性选项卡;
if (蓝牙是否已连接？) then (否)
  partition 蓝牙连接流程 {
    :尝试建立蓝牙连接;
    if (连接成功？) then (是)
      :标记连接状态为成功;
    else (否)
      :直接返回;
      stop
    endif
  }
else (是)
  :保持当前连接;
endif

partition 安全性界面 {
'   :加载安全性配置数据;
  
'   *** 手机钥匙管理 ***
  group 手机钥匙管理
  if (手机钥匙开关操作) then (是)
    :调用后台接口保存开关状态;
    if (保存成功？) then (是)
      :更新本地显示状态;
    else (否)
      :提示打开/关闭失败;
    endif
  endif
  end group

'   *** 车钥匙列表 ***
group 车钥匙列表
  if (手机钥匙处于开启状态) then (是)
    :展示车钥匙列表;
    if (点击删除按钮) then (是)
      :调用后台接口删除钥匙;
      :刷新列表;
    else (点击空白列表项)
      :从后台获取新钥匙字符串;
      :复制到剪贴板;
      :显示分享提示;
    endif
  endif
  end group

'   *** 速度限制模式 ***
  group 速度限制模式
  if (速度限制开关操作) then (是)
    :调用后台接口保存限速状态;
    if (保存失败？) then (是)
      :恢复原开关状态;
    endif
  endif
  end group
}

:返回主界面;
' stop

@enduml