@startuml

start
:用户点击遥控器选项卡;
if (车辆蓝牙是否已连接？) then (否)
  partition 蓝牙连接流程 {
    :搜索附近蓝牙设备;
    :选择目标三轮车设备;
    :尝试建立蓝牙连接;
    if (连接成功？) then (是)
      :标记连接状态为成功;
    else (否)
      :直接返回;
      stop
    endif
  }
else (是)
  :跳过连接步骤;
endif

partition 遥控器界面 {
  :进入遥控器控制界面;
  repeat
    :通过蓝牙实时接收数据;
    :更新剩余电量/速度/里程/距离;
  repeat while (界面是否保持打开？)

  :显示控制按钮（前进/后退/车灯/喇叭）;
  if (用户操作按钮) then (是)
    :通过蓝牙发送控制指令;
  else (否)
    :等待用户操作;
  endif
}

:返回主界面;
stop
@enduml