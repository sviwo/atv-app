@startuml
start
:用户启动APP;
partition 初始化语言配置 {
  :设置支持的语言列表;
  :读取本地保存的语言选择;
  :读取系统语言;
  if (有保存的本地语言选择) then(是)
  :设置语言为此语言;
  else(否)
  if (支持该系统语言?) then (是)
    :设置语言=系统语言;
  else (否)
    :设置默认语言=英语(en);
  endif
  :保存设置到本地语言选择;
  endif
}

partition 主界面显示 {
  :按当前语言渲染UI;
}

partition 语言切换流程 {
  :用户进入语言选择界面，展示可用语言列表;
  :点击具体语言选项;
  if (选择新语言) then (是)
    :保存新语言配置到本地存储;
    :触发全局界面刷新;
  else (否)
    :什么也不做;
  endif
}
stop
@enduml