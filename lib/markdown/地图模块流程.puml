@startuml
start
:用户点击地点选项卡;
:进入地图交互页面;
partition 定位鉴权 {
  if (定位权限已开启?) then (否)
    :请求定位权限;
    if (用户拒绝授权?) then (是)
      :显示"需要定位权限"提示;
      stop
    endif
  endif
  :获取并标记用户当前位置;
  :标记车辆当前位置;
}

partition 找车流程 {
  :点击"寻找车辆"按钮;
  
    if (国内区域?) then (是)
      :高德地图标记车辆位置;
    else (否)
      :谷歌地图标记车辆位置;
    endif
    :显示车辆位置与距离;
    :生成导航至车辆的路线;
}

partition 目的地导航 {
  :输入目的地地址;
  :调用地理编码服务;
  :查询附近POI供用户选择;
  if (地址解析成功?) then (是)
    :计算最佳路线;
    fork
      :绘制导航路线;
      :语音播报转向提示;
    fork again
      :后台记录导航轨迹;
    end fork
    :实时更新剩余里程/时间;
  else (否)
    :提示"无效地址，请重试";
  endif
}

:返回地图交互界面;
stop
@enduml